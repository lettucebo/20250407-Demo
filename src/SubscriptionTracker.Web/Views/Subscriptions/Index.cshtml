@using SubscriptionTracker.Web.Models.ViewModels
@model SubscriptionDashboardViewModel
@{
    ViewData["Title"] = "Subscriptions";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Subscriptions</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus"></i> Create Subscription
    </a>
</div>

<div class="row">
    <div class="col-md-12 mb-4">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="card-title">Total Monthly Cost</h5>
                    <h3 class="text-primary mb-0">@Model.TotalMonthlyCost.ToString("C2")</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-4">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Upcoming Payments</h5>
            </div>
            <div class="card-body">
                @if (!Model.UpcomingPayments.Any())
                {
                    <p class="text-muted">No upcoming payments.</p>
                }
                else
                {
                    <div class="list-group">
                        @foreach (var payment in Model.UpcomingPayments)
                        {
                            <div class="list-group-item">
                                <div class="d-flex w-100 justify-content-between">
                                    <h6 class="mb-1">@payment.Name</h6>
                                    <small class="text-primary">@payment.Cost.ToString("C2")</small>
                                </div>
                                <div class="d-flex w-100 justify-content-between">
                                    <small>
                                        <span class="badge" style="background-color: @payment.CategoryColor">
                                            @payment.CategoryName
                                        </span>
                                    </small>
                                    <small class="text-muted">
                                        @(payment.DaysUntilPayment == 0 ? "Due today" :
                                            payment.DaysUntilPayment == 1 ? "Due tomorrow" :
                                            $"Due in {payment.DaysUntilPayment} days")
                                    </small>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-8 mb-4">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">All Subscriptions</h5>
            </div>
            <div class="card-body">
                @if (!Model.ActiveSubscriptions.Any())
                {
                    <p class="text-muted">No active subscriptions. Click the Create Subscription button to add one.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Category</th>
                                    <th>Cost</th>
                                    <th>Next Payment</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var subscription in Model.ActiveSubscriptions)
                                {
                                    <tr>
                                        <td>@subscription.Name</td>
                                        <td>
                                            <span class="badge" style="background-color: @subscription.CategoryColor">
                                                @subscription.CategoryName
                                            </span>
                                        </td>
                                        <td>@subscription.Cost.ToString("C2")</td>
                                        <td>
                                            @subscription.PaymentTime.LocalDateTime.ToString("MMM dd, yyyy")
                                            <br />
                                            <small class="text-muted">
                                                @(subscription.DaysUntilPayment == 0 ? "Due today" :
                                                    subscription.DaysUntilPayment == 1 ? "Due tomorrow" :
                                                    $"Due in {subscription.DaysUntilPayment} days")
                                            </small>
                                        </td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <a asp-action="Edit" asp-route-id="@subscription.Id" 
                                                   class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <form asp-action="Delete" asp-route-id="@subscription.Id" 
                                                      onsubmit="return confirm('Are you sure you want to delete this subscription?');"
                                                      style="display: inline;">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>