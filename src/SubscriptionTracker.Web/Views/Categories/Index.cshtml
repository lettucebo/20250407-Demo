@using SubscriptionTracker.Web.Models.ViewModels
@model IEnumerable<CategoryViewModel>
@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Categories</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus"></i> Create Category
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info" role="alert">
        No categories found. Click the Create Category button to add one.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var category in Model)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-header" style="background-color: @category.Color">
                        <h5 class="card-title mb-0 text-white">@category.Name</h5>
                    </div>
                    <div class="card-body">
                        <p class="card-text">
                            <strong>Total Cost:</strong> @category.TotalCost.ToString("C2")
                        </p>
                        <p class="card-text">
                            <strong>Subscriptions:</strong> @category.SubscriptionCount
                        </p>
                    </div>
                    <div class="card-footer bg-transparent">
                        <div class="d-flex justify-content-between">
                            <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            @if (category.SubscriptionCount == 0)
                            {
                                <form asp-action="Delete" asp-route-id="@category.Id" 
                                      onsubmit="return confirm('Are you sure you want to delete this category?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}